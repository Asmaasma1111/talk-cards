  "uses": [
   "S1-RC1",
   "S1-CS1"
  ]
 },
 {
  "id": "c7f6dc3b7",
  "text": "قَالَتْ لِينَا لِأُمِّهَا: أَيْنَ كِتَابِي الْجَدِيدُ؟",
  "kind": "sentence",
