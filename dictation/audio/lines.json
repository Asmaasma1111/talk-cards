 },
 {
  "id": "ccef59bed",
  "text": "فِي الصَّبَاحِ تُشْرِقُ الشَّمْسُ، فَيَسْتَيْقِظُ الْعُصْفُورُ. يَطِيرُ الْعُصْفُورُ إِلَى الشَّجَرَةِ، وَيُغَنِّي لِلزُّهُورِ. وَفِي اللَّيْلِ يَنَامُ، وَيَظْهَرُ الْقَمَرُ.",
  "kind": "dictation",
  "uses": [
   "S2-TX1"
  ]
 },
